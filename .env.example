# Qdrant Configuration
QDRANT_MODE=local
QDRANT_URL=http://localhost:6333

# Model Configuration
# Options: opencode/deepseek-v4.1-flash-free, opencode/glm-5.3-flash-free, Qwen/Qwen2.5-VL-7B-Instruct, etc.
VLM_MODEL=opencode/deepseek-v4.1-flash-free
# When using OpenCode or a local bridge endpoint (e.g., http://localhost:18787/v1 or http://localhost:11434/v1):
VLM_API_ENDPOINT=
VLM_API_KEY=
COLQWEN_MODEL=vidore/colqwen2.5-v0.2

# Runtime
DEVICE=auto
TOP_K=2
CONFIDENCE_THRESHOLD=0.5
